    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ddd6e3c0-26d7-4da0-b429-f43598d6af2f</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
