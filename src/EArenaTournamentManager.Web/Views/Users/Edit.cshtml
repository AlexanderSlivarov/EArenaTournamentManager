@model EArenaTournamentManager.Web.Models.Users.UserRequest
@{
    ViewData["Title"] = "Edit User";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Edit User</h2>
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control"
                       placeholder="Leave blank to keep current password" />
            </div>
            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    <option value="Member">Member</option>
                    <option value="Organizer">Organizer</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="AvatarImageUrl" class="form-label">Avatar</label>
                <input type="hidden" asp-for="AvatarImageUrl" id="avatarImageUrl" />
                <input type="file" class="form-control" id="avatarFile" accept="image/*" />
                <div class="form-text">Choose an image</div>
                <div class="mt-2">
                    <img id="avatarPreview"
                         src="@(string.IsNullOrEmpty(Model.AvatarImageUrl) ? string.Empty : Model.AvatarImageUrl)"
                         alt="Avatar preview"
                         class="@(string.IsNullOrEmpty(Model.AvatarImageUrl) ? "d-none " : string.Empty)img-thumbnail"
                         style="max-width:120px;max-height:120px;object-fit:cover;" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const avatarFile = document.getElementById('avatarFile');
        const avatarImageUrl = document.getElementById('avatarImageUrl');
        const avatarPreview = document.getElementById('avatarPreview');

        avatarImageUrl.value = avatarPreview.getAttribute('src') || '';

        avatarFile.addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (!file) {
                avatarImageUrl.value = avatarPreview.getAttribute('src') || '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (event) {
                avatarImageUrl.value = event.target.result;
                avatarPreview.src = event.target.result;
                avatarPreview.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        });
    </script>
}