@model EArenaTournamentManager.Web.Models.Users.UserRequest
@{
    ViewData["Title"] = "Profile";
    var profileUser = ViewBag.ProfileUser as EArenaTournamentManager.Web.Models.Users.UserResponse;
    var myTeams = ViewBag.MyTeams as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var myOrgs = ViewBag.MyOrganizations as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Profile</h2>

        @if (profileUser is not null)
        {
            <div class="card mb-4">
                <div class="card-body d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(profileUser.AvatarImageUrl))
                    {
                        <label for="avatarFile" class="m-0" style="cursor:pointer;">
                            <img src="@profileUser.AvatarImageUrl" alt="@profileUser.Username"
                                 style="width:72px;height:72px;object-fit:cover;border-radius:50%;" />
                        </label>
                    }
                    else
                    {
                        <label for="avatarFile" class="m-0" style="cursor:pointer;">
                            <span style="width:72px;height:72px;border-radius:50%;background:#6c757d;display:inline-flex;align-items:center;justify-content:center;color:white;font-size:28px;">
                                @profileUser.Username[0].ToString().ToUpper()
                            </span>
                        </label>
                    }
                    <div>
                        <h4 class="mb-0">@profileUser.Username</h4>
                        <div class="text-muted">@profileUser.Email</div>
                    </div>
                </div>
            </div>
        }

        <form asp-action="Profile" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">               
                <input type="hidden" asp-for="AvatarImageUrl" id="avatarImageUrl" />
                <div>
                    <img id="avatarPreview"
                         src="@(string.IsNullOrEmpty(Model.AvatarImageUrl) ? string.Empty : Model.AvatarImageUrl)"
                         alt="Avatar preview"
                         class="@(string.IsNullOrEmpty(Model.AvatarImageUrl) ? "d-none " : string.Empty)img-thumbnail mb-2"
                         style="width:80px;height:80px;object-fit:cover;border-radius:50%;cursor:pointer;" />
                </div>
                <input type="file" class="d-none" id="avatarFile" accept="image/*" />                
            </div>

            <button type="submit" class="btn btn-primary">Save Profile</button>
        </form>

        <div class="mt-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h5 mb-0">My organizations</h3>
                <span class="badge text-bg-secondary">@myOrgs.Count()</span>
            </div>

            @if (myOrgs.Any())
            {
                <div class="row g-3 mb-4">
                    @foreach (var org in myOrgs)
                    {
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-body d-flex gap-3">
                                    @if (!string.IsNullOrWhiteSpace((string?)org.LogoImageUrl))
                                    {
                                        <img src="@org.LogoImageUrl" alt="@org.Name"
                                             style="width:56px;height:56px;object-fit:cover;border-radius:12px;" />
                                    }
                                    else
                                    {
                                        <div style="width:56px;height:56px;border-radius:12px;background:#6c757d;display:flex;align-items:center;justify-content:center;color:white;font-weight:600;">
                                            @(((string)org.Name)[0].ToString().ToUpper())
                                        </div>
                                    }
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between gap-2">
                                            <div>
                                                <h4 class="h6 mb-1">@org.Name</h4>
                                                <div class="text-muted small">@org.Description</div>
                                            </div>
                                            <span class="badge text-bg-primary align-self-start">@org.Role</span>
                                        </div>
                                        <div class="mt-2 text-muted small">
                                            Joined @DateTimeOffset.FromUnixTimeSeconds(Convert.ToInt64(org.JoinedOn)).ToLocalTime().ToString("dd MMM yyyy")
                                        </div>
                                        <a class="stretched-link" asp-controller="Organizations" asp-action="Details" asp-route-id="@org.Id"></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border mb-4">No organizations yet.</div>
            }

            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h5 mb-0">My teams</h3>
                <span class="badge text-bg-secondary">@myTeams.Count()</span>
            </div>

            @if (myTeams.Any())
            {
                <div class="row g-3">
                    @foreach (var team in myTeams)
                    {
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-body d-flex gap-3">
                                    @if (!string.IsNullOrWhiteSpace((string?)team.LogoImageUrl))
                                    {
                                        <img src="@team.LogoImageUrl" alt="@team.Name"
                                             style="width:56px;height:56px;object-fit:cover;border-radius:12px;" />
                                    }
                                    else
                                    {
                                        <div style="width:56px;height:56px;border-radius:12px;background:#6c757d;display:flex;align-items:center;justify-content:center;color:white;font-weight:600;">
                                            @(((string)team.Name)[0].ToString().ToUpper())
                                        </div>
                                    }
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between gap-2">
                                            <div>
                                                <h4 class="h6 mb-1">@team.Name</h4>
                                                <div class="text-muted small">@team.Description</div>
                                            </div>
                                            <span class="badge text-bg-primary align-self-start">@team.Role</span>
                                        </div>
                                        <div class="mt-2 text-muted small">
                                            Joined @DateTimeOffset.FromUnixTimeSeconds(Convert.ToInt64(team.JoinedOn)).ToLocalTime().ToString("dd MMM yyyy")
                                        </div>
                                        <a class="stretched-link" asp-controller="Teams" asp-action="Details" asp-route-id="@team.Id"></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border mb-0">No teams yet.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function bindImagePicker(fileInputId, hiddenInputId, previewId, maxWidth, maxHeight, quality) {
            const fileInput = document.getElementById(fileInputId);
            const hiddenInput = document.getElementById(hiddenInputId);
            const preview = document.getElementById(previewId);

            hiddenInput.value = preview.getAttribute('src') || '';
            preview.addEventListener('click', () => fileInput.click());

            fileInput.addEventListener('change', function () {
                const file = this.files && this.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = new Image();
                    img.onload = function () {
                        const canvas = document.createElement('canvas');

                        let width = img.width;
                        let height = img.height;

                        if (width > maxWidth) {
                            height = Math.round(height * maxWidth / width);
                            width = maxWidth;
                        }
                        if (height > maxHeight) {
                            width = Math.round(width * maxHeight / height);
                            height = maxHeight;
                        }

                        canvas.width = width;
                        canvas.height = height;
                        canvas.getContext('2d').drawImage(img, 0, 0, width, height);

                        const compressed = canvas.toDataURL('image/jpeg', quality);
                        hiddenInput.value = compressed;
                        preview.src = compressed;
                        preview.classList.remove('d-none');
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        bindImagePicker('avatarFile', 'avatarImageUrl', 'avatarPreview', 300, 300, 0.85);
    </script>
}