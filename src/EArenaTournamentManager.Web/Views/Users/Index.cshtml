@model List<EArenaTournamentManager.Web.Models.Users.UserResponse>

@{
    ViewData["Title"] = "Users";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Users</h2>

    @if (ViewBag.IsLoggedIn == true)
    {
        <a asp-action="Create" class="btn btn-primary">Create User</a>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">No users found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(user.AvatarImageUrl))
                                {
                                    <img src="@user.AvatarImageUrl"
                                         alt="@user.Username"
                                         style="width:36px;height:36px;object-fit:cover;border-radius:50%;" />
                                }
                                else
                                {
                                    <span style="width:36px;height:36px;border-radius:50%;background:#6c757d;display:inline-flex;align-items:center;justify-content:center;color:white;font-size:14px;">
                                        @user.Username[0].ToString().ToUpper()
                                    </span>
                                }

                                <strong>@user.Username</strong>
                            </div>
                        </td>

                        <td>@user.Email</td>

                        <td>
                            <span class="badge bg-primary">
                                @user.Role
                            </span>
                        </td>

                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>

                        <td>
                            @(DateTimeOffset.FromUnixTimeSeconds(user.CreatedOn).ToString("dd MMM yyyy"))
                        </td>

                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@user.Id"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete this user?')">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}