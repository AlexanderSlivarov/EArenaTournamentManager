@model List<EArenaTournamentManager.Web.Models.Users.UserResponse>

@{
    ViewData["Title"] = "Users";
    var usernameFilter = ViewBag.UsernameFilter as string ?? string.Empty;
    var emailFilter = ViewBag.EmailFilter as string ?? string.Empty;
    var roleFilter = ViewBag.RoleFilter as string ?? string.Empty;
    var currentPage = ViewBag.CurrentPage is int pageNumber ? pageNumber : 1;
    var pageSize = ViewBag.PageSize is int size ? size : 10;
    var pager = ViewBag.Pager as EArenaTournamentManager.Web.Models.Shared.PagerResponse;
    var totalCount = pager?.Count ?? Model.Count;
    var totalPages = pageSize > 0 ? (int)Math.Ceiling(totalCount / (double)pageSize) : 1;
    if (totalPages < 1)
    {
        totalPages = 1;
    }
    var pageSizes = new[] { 5, 10, 25, 50 };
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Users</h2>

    @if (ViewBag.IsLoggedIn == true)
    {
        <a asp-action="Create" class="btn btn-primary">Create User</a>
    }
</div>

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Username</label>
            <input type="text" name="username" value="@usernameFilter" class="form-control" placeholder="Search username" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Email</label>
            <input type="text" name="email" value="@emailFilter" class="form-control" placeholder="Search email" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Role</label>
            <select name="role" class="form-select">
                @if (string.IsNullOrWhiteSpace(roleFilter))
                {
                    <option value="" selected>All roles</option>
                }
                else
                {
                    <option value="">All roles</option>
                }

                @if (string.Equals(roleFilter, "Member", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Member" selected>Member</option>
                }
                else
                {
                    <option value="Member">Member</option>
                }

                @if (string.Equals(roleFilter, "Organizer", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Organizer" selected>Organizer</option>
                }
                else
                {
                    <option value="Organizer">Organizer</option>
                }

                @if (string.Equals(roleFilter, "Admin", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Admin" selected>Admin</option>
                }
                else
                {
                    <option value="Admin">Admin</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No users found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(user.AvatarImageUrl))
                                {
                                    <img src="@user.AvatarImageUrl"
                                         alt="@user.Username"
                                         style="width:36px;height:36px;object-fit:cover;border-radius:50%;" />
                                }
                                else
                                {
                                    <span style="width:36px;height:36px;border-radius:50%;background:#6c757d;display:inline-flex;align-items:center;justify-content:center;color:white;font-size:14px;">
                                        @user.Username[0].ToString().ToUpper()
                                    </span>
                                }

                                <strong>@user.Username</strong>
                            </div>
                        </td>

                        <td>@user.Email</td>

                        <td>
                            <span class="badge bg-primary">
                                @user.Role
                            </span>
                        </td>

                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>

                        <td>
                            @(DateTimeOffset.FromUnixTimeSeconds(user.CreatedOn).ToString("dd MMM yyyy"))
                        </td>

                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@user.Id"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete this user?')">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mt-4">
    <div class="text-muted">
        Page @currentPage / @totalPages
    </div>

    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
        <div class="d-flex align-items-center gap-2">
            <label for="userPageSize" class="text-muted mb-0">Page size</label>
            <form method="get" class="d-inline">
                <input type="hidden" name="username" value="@usernameFilter" />
                <input type="hidden" name="email" value="@emailFilter" />
                <input type="hidden" name="role" value="@roleFilter" />
                <input type="hidden" name="page" value="1" />
                <select id="userPageSize" name="pageSize" class="form-select" onchange="this.form.submit()" style="width:auto;min-width:110px;">
                    @foreach (var sizeOption in pageSizes)
                    {
                        if (sizeOption == pageSize)
                        {
                            <option value="@sizeOption" selected>@sizeOption</option>
                        }
                        else
                        {
                            <option value="@sizeOption">@sizeOption</option>
                        }
                    }
                </select>
            </form>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : string.Empty)"
               asp-action="Index"
               asp-route-username="@usernameFilter"
               asp-route-email="@emailFilter"
               asp-route-role="@roleFilter"
               asp-route-page="@(currentPage - 1)"
               asp-route-pageSize="@pageSize">Prev</a>

            <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : string.Empty)"
               asp-action="Index"
               asp-route-username="@usernameFilter"
               asp-route-email="@emailFilter"
               asp-route-role="@roleFilter"
               asp-route-page="@(currentPage + 1)"
               asp-route-pageSize="@pageSize">Next</a>
        </div>
    </div>
</div>