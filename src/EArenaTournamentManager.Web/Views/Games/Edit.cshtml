@model EArenaTournamentManager.Web.Models.Games.GameRequest
@{
    ViewData["Title"] = "Edit Game";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Edit Game</h2>
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Platform" class="form-label"></label>
                <select asp-for="Platform" class="form-select">
                    <option value="PC">PC</option>
                    <option value="PlayStation4">PlayStation 4</option>
                    <option value="XBoxOne">Xbox One</option>
                    <option value="Mobile">Mobile</option>
                    <option value="Switch">Switch</option>
                    <option value="CrossPlatform">Cross Platform</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Image</label>
                <input type="hidden" asp-for="ImageUrl" id="imageUrl" />
                <div>
                    <img id="imagePreview"
                         src="@(string.IsNullOrEmpty(Model.ImageUrl) ? string.Empty : Model.ImageUrl)"
                         alt="Image preview"
                         class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none " : string.Empty)img-thumbnail mb-2"
                         style="max-width:160px;max-height:120px;object-fit:cover;cursor:pointer;" />
                </div>
                <input type="file" class="d-none" id="imageFile" accept="image/*" />
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        onclick="document.getElementById('imageFile').click()">
                    Choose Image
                </button>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        bindImagePicker('imageFile', 'imageUrl', 'imagePreview', 'games');
    </script>
}