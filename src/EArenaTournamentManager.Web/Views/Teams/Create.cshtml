@model EArenaTournamentManager.Web.Models.Teams.TeamRequest
@{
    ViewData["Title"] = "Create Team";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Create Team</h2>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Captain</label>
                <input type="hidden" asp-for="CaptainId" />
                @if (ViewBag.IsAdmin == true)
                {
                    <select asp-for="CaptainUsername" class="form-select">                        
                        @foreach (var user in (ViewBag.Users as IEnumerable<EArenaTournamentManager.Web.Models.Users.UserResponse> ?? Enumerable.Empty<EArenaTournamentManager.Web.Models.Users.UserResponse>()))
                        {
                            <option value="@user.Username">@user.Username</option>
                        }
                    </select>
                    <div class="form-text">Select the captain of this team.</div>
                }
                else
                {
                    <input asp-for="CaptainUsername" class="form-control" readonly />
                    <div class="form-text">You are the captain of this team.</div>
                }
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Logo</label>
                <input type="hidden" asp-for="LogoImageUrl" id="logoImageUrl" />
                <div>
                    <img id="logoPreview"
                         src="@(string.IsNullOrEmpty(Model.LogoImageUrl) ? string.Empty : Model.LogoImageUrl)"
                         alt="Logo preview"
                         class="@(string.IsNullOrEmpty(Model.LogoImageUrl) ? "d-none " : string.Empty)img-thumbnail mb-2"
                         style="max-width:160px;max-height:160px;object-fit:cover;border-radius:12px;cursor:pointer;" />
                </div>
                <input type="file" class="d-none" id="logoFile" accept="image/*" />
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        onclick="document.getElementById('logoFile').click()">
                    Choose Logo
                </button>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        bindImagePicker('logoFile', 'logoImageUrl', 'logoPreview', 'teams');
    </script>
}