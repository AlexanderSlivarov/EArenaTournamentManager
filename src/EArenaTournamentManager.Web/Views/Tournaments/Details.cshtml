@model EArenaTournamentManager.Web.Models.Tournaments.TournamentResponse
@{
    ViewData["Title"] = Model.Name;
    var participants = ViewBag.Participants as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var participantsPager = ViewBag.ParticipantsPager as EArenaTournamentManager.Web.Models.Shared.PagerResponse;
    var currentPage = ViewBag.ParticipantsCurrentPage is int pageNumber ? pageNumber : 1;
    var pageSize = ViewBag.ParticipantsPageSize is int size ? size : 10;
    var totalCount = participantsPager?.Count ?? participants.Count();
    var totalPages = pageSize > 0 ? (int)Math.Ceiling(totalCount / (double)pageSize) : 1;
    if (totalPages < 1)
    {
        totalPages = 1;
    }
    var pageSizes = new[] { 5, 10, 25, 50 };
    var myTeams = ViewBag.MyTeams as IEnumerable<EArenaTournamentManager.Web.Models.Teams.TeamResponse>
                  ?? Enumerable.Empty<EArenaTournamentManager.Web.Models.Teams.TeamResponse>();
    var myRegisteredTeamIds = ViewBag.MyRegisteredTeamIds as HashSet<int> ?? new HashSet<int>();
    var canManage = ViewBag.IsAdmin == true || ViewBag.IsOrganizer == true || (Model.CreatedBy == ViewBag.CurrentUserId);
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Model.Name</h2>
    <div class="d-flex gap-2">
        @if (canManage)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-danger"
                        onclick="return confirm('Delete this tournament?')">
                    Delete
                </button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-primary">Back to list</a>
    </div>
</div>
<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Tournament Info</h5>
                @if (!string.IsNullOrEmpty(Model.LogoImageUrl))
                {
                    <div class="mb-3">
                        <img src="@Model.LogoImageUrl" alt="@Model.Name logo"
                             class="img-thumbnail"
                             style="max-width:220px;max-height:220px;object-fit:cover;" />
                    </div>
                }
                <dl class="row">
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-@(Model.Status == "Upcoming" ? "warning" : Model.Status == "Open" ? "success" : Model.Status == "Closed" ? "secondary" : "danger")">
                            @Model.Status
                        </span>
                    </dd>
                    <dt class="col-sm-3">Start Date</dt>
                    <dd class="col-sm-9">@DateTimeOffset.FromUnixTimeSeconds(Model.StartDate > 0 ? Model.StartDate : Model.DateTime).ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                    <dt class="col-sm-3">End Date</dt>
                    <dd class="col-sm-9">@DateTimeOffset.FromUnixTimeSeconds(Model.EndDate > 0 ? Model.EndDate : (Model.StartDate > 0 ? Model.StartDate : Model.DateTime)).ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                    @if (!string.IsNullOrEmpty(Model.Format))
                    {
                        <dt class="col-sm-3">Format</dt>
                        <dd class="col-sm-9">@Model.Format</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.Map))
                    {
                        <dt class="col-sm-3">Map</dt>
                        <dd class="col-sm-9">@Model.Map</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.Region))
                    {
                        <dt class="col-sm-3">Region</dt>
                        <dd class="col-sm-9">@Model.Region</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.Prizes))
                    {
                        <dt class="col-sm-3">Prizes</dt>
                        <dd class="col-sm-9">@Model.Prizes</dd>
                    }
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Rules))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Rules</h5>
                    <p>@Model.Rules</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.FullDescription))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">FullDescription</h5>
                    <p>@Model.FullDescription</p>
                </div>
            </div>
        }

        @* Registration section — only when tournament is Open *@
        @if (ViewBag.IsLoggedIn == true && Model.Status == "Open")
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Register a Team</h5>
                    @if (!myTeams.Any())
                    {
                        <p class="text-muted mb-0">
                            You are not a captain of any team.
                            <a asp-controller="Teams" asp-action="Create">Create a team</a> to participate.
                        </p>
                    }
                    else
                    {
                        @* Show which of the user's teams are already registered *@
                        var availableTeams = myTeams.Where(t => !myRegisteredTeamIds.Contains(t.Id)).ToList();
                        var alreadyRegisteredTeams = myTeams.Where(t => myRegisteredTeamIds.Contains(t.Id)).ToList();

                        @if (alreadyRegisteredTeams.Any())
                        {
                            <div class="alert alert-info mb-3">
                                @if (alreadyRegisteredTeams.Count == 1)
                                {
                                    <text>Your team <strong>@alreadyRegisteredTeams[0].Name</strong> is already registered for this tournament.</text>
                                }
                                else
                                {
                                    <text>
                                        The following of your teams are already registered:
                                        <strong>@string.Join(", ", alreadyRegisteredTeams.Select(t => t.Name))</strong>
                                    </text>
                                }
                            </div>
                        }

                        @if (availableTeams.Any())
                        {
                            <form asp-controller="TournamentParticipants" asp-action="Create" method="post">
                                <input type="hidden" name="TournamentId" value="@Model.Id" />
                                <input type="hidden" name="TeamId" value="0" />
                                <div class="mb-3">
                                    <label class="form-label">Your Team</label>
                                    <select name="TeamName" class="form-select" required>
                                        
                                        @foreach (var team in availableTeams)
                                        {
                                            <option value="@team.Name">@team.Name</option>
                                        }

                                    </select>
                                </div>
                                <button type="submit" class="btn btn-primary">Register</button>
                            </form>
                        }
                        else if (!alreadyRegisteredTeams.Any())
                        {
                            <p class="text-muted mb-0">All your teams are already registered.</p>
                        }
                    }
                </div>
            </div>
        }
               
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">Registered Teams</h5>
                    <span class="badge text-bg-secondary">@totalCount</span>
                </div>
                <div class="mb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-10">
                            <label for="tournamentParticipantsTeamFilter" class="form-label small text-muted mb-1">Team name</label>
                            <input id="tournamentParticipantsTeamFilter" type="search" class="form-control form-control-sm" placeholder="Search team name" />
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button id="tournamentParticipantsApplyFilter" type="button" class="btn btn-sm btn-primary w-100">Filter</button>
                            <button id="tournamentParticipantsClearFilter" type="button" class="btn btn-sm btn-outline-secondary w-100">Clear</button>
                        </div>
                    </div>
                </div>
                @if (!participants.Any())
                {
                    <p class="text-muted mb-0">No teams registered yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Team</th>
                                    <th>Joined On</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="tournamentParticipantsTableBody">
                                @foreach (var p in participants)
                                {
                                    <tr data-team-name="@p.TeamName">
                                        <td>
                                            <a asp-controller="Teams" asp-action="Details" asp-route-id="@p.TeamId">
                                                @p.TeamName
                                            </a>
                                        </td>
                                        <td>@DateTimeOffset.FromUnixTimeSeconds((long)p.JoinedOn).ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                        <td>
                                            @if (canManage)
                                            {
                                                <form asp-controller="TournamentParticipants" asp-action="Delete" method="post">
                                                    <input type="hidden" name="id" value="@p.Id" />
                                                    <input type="hidden" name="tournamentId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Remove this team from the tournament?')">
                                                        Remove
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p id="tournamentParticipantsFilterEmpty" class="text-muted mt-3 mb-0 d-none">No registered teams match your search.</p>
                }
            </div>
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 px-3 pb-3 pt-3">
                <div class="text-muted">Page @currentPage / @totalPages</div>
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <label for="participantPageSize" class="text-muted mb-0">Page size</label>
                        <form method="get" asp-action="Details" asp-route-id="@Model.Id" class="d-inline">
                            <input type="hidden" name="page" value="1" />
                            <select id="participantPageSize" name="pageSize" class="form-select" onchange="this.form.submit()" style="width:auto;min-width:110px;">
                                @foreach (var sizeOption in pageSizes)
                                {
                                    if (sizeOption == pageSize)
                                    {
                                        <option value="@sizeOption" selected>@sizeOption</option>
                                    }
                                    else
                                    {
                                        <option value="@sizeOption">@sizeOption</option>
                                    }
                                }
                            </select>
                        </form>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : string.Empty)"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-pageSize="@pageSize">Prev</a>
                        <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : string.Empty)"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-pageSize="@pageSize">Next</a>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.IsAdmin == true)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Metadata</h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Created By</dt>
                        <dd class="col-sm-9">@Model.CreatedBy</dd>
                        <dt class="col-sm-3">Created On</dt>
                        <dd class="col-sm-9">@((Model.CreatedOn > 0) ? DateTimeOffset.FromUnixTimeSeconds(Model.CreatedOn).ToLocalTime().ToString("dd MMM yyyy HH:mm") : string.Empty)</dd>
                        <dt class="col-sm-3">Updated By</dt>
                        <dd class="col-sm-9">@(Model.UpdatedBy.HasValue? Model.UpdatedBy.Value.ToString() : "-")</dd>
                        <dt class="col-sm-3">Updated On</dt>
                        <dd class="col-sm-9">@(Model.UpdatedOn.HasValue? DateTimeOffset.FromUnixTimeSeconds(Model.UpdatedOn.Value).ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-")</dd>
                        <dt class="col-sm-3">Active</dt>
                        <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
                    </dl>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const teamInput = document.getElementById('tournamentParticipantsTeamFilter');
            const applyButton = document.getElementById('tournamentParticipantsApplyFilter');
            const clearButton = document.getElementById('tournamentParticipantsClearFilter');
            const rows = Array.from(document.querySelectorAll('#tournamentParticipantsTableBody tr'));
            const emptyState = document.getElementById('tournamentParticipantsFilterEmpty');

            if (!teamInput || !applyButton || !clearButton) {
                return;
            }

            const applyFilter = () => {
                const teamTerm = teamInput.value.trim().toLowerCase();
                let visibleCount = 0;

                rows.forEach((row) => {
                    const rowTeamName = (row.dataset.teamName || '').toLowerCase();
                    const matches = !teamTerm || rowTeamName.includes(teamTerm);
                    row.classList.toggle('d-none', !matches);
                    if (matches) {
                        visibleCount += 1;
                    }
                });

                if (emptyState) {
                    emptyState.classList.toggle('d-none', visibleCount > 0);
                }
            };

            applyButton.addEventListener('click', applyFilter);
            clearButton.addEventListener('click', () => {
                teamInput.value = '';
                applyFilter();
            });
        })();
    </script>
}