@model EArenaTournamentManager.Web.Models.Tournaments.TournamentRequest
@{
    ViewData["Title"] = "Edit Tournament";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">Edit Tournament</h2>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Game</label>
                    <input type="hidden" asp-for="GameId" />
                    @if (ViewBag.IsAdmin is true || ViewBag.IsOrganizer is true)
                    {
                        <select asp-for="GameName" class="form-select">
                            @foreach (var game in (ViewBag.Games as IEnumerable<EArenaTournamentManager.Web.Models.Games.GameResponse> ?? Enumerable.Empty<EArenaTournamentManager.Web.Models.Games.GameResponse>()))
                            {
                                <option value="@game.Name">@game.Name</option>
                            }
                        </select>
                    }
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Organization</label>
                    <input type="hidden" asp-for="OrganizationId" />
                    @if (ViewBag.IsAdmin is true || ViewBag.IsOrganizer is true)
                    {
                        <select asp-for="OrganizationName" class="form-select">
                            @foreach (var organization in (ViewBag.Organizations as IEnumerable<EArenaTournamentManager.Web.Models.Organizations.OrganizationResponse> ?? Enumerable.Empty<EArenaTournamentManager.Web.Models.Organizations.OrganizationResponse>()))
                            {
                                <option value="@organization.Name">@organization.Name</option>
                            }
                        </select>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Logo</label>
                <input type="hidden" asp-for="LogoImageUrl" id="logoImageUrl" />
                <div>
                    <img id="logoPreview"
                         src="@(string.IsNullOrEmpty(Model.LogoImageUrl) ? string.Empty : Model.LogoImageUrl)"
                         alt="Logo preview"
                         class="@(string.IsNullOrEmpty(Model.LogoImageUrl) ? "d-none " : string.Empty)img-thumbnail mb-2"
                         style="max-width:160px;max-height:160px;object-fit:cover;border-radius:12px;cursor:pointer;" />
                </div>
                <input type="file" class="d-none" id="logoFile" accept="image/*" />
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        onclick="document.getElementById('logoFile').click()">
                    Choose Logo
                </button>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Format" class="form-label"></label>
                    <textarea asp-for="Format" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Region" class="form-label"></label>
                    <input asp-for="Region" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Map" class="form-label"></label>
                <input asp-for="Map" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input type="datetime-local" class="form-control" id="startDatePicker"
                           value='@(Model.StartDate > 0 ? DateTimeOffset.FromUnixTimeSeconds(Model.StartDate).ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : string.Empty)' required />
                    <input asp-for="StartDate" type="hidden" id="startDateUnix" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input type="datetime-local" class="form-control" id="endDatePicker"
                           value='@(Model.EndDate > 0 ? DateTimeOffset.FromUnixTimeSeconds(Model.EndDate).ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : (Model.StartDate > 0 ? DateTimeOffset.FromUnixTimeSeconds(Model.StartDate).ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : string.Empty))' required />
                    <input asp-for="EndDate" type="hidden" id="endDateUnix" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="Upcoming">Upcoming</option>
                        <option value="Closed">Closed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Prizes" class="form-label"></label>
                <textarea asp-for="Prizes" class="form-control" rows="4"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Rules" class="form-label"></label>
                <textarea asp-for="Rules" class="form-control" rows="4"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        bindImagePicker('logoFile', 'logoImageUrl', 'logoPreview', 'tournaments');

        const startPicker = document.getElementById('startDatePicker');
        const endPicker = document.getElementById('endDatePicker');
        const startUnix = document.getElementById('startDateUnix');
        const endUnix = document.getElementById('endDateUnix');

        const syncUnix = (picker, target) => {
            const date = picker.value ? new Date(picker.value) : null;
            target.value = date && !Number.isNaN(date.getTime()) ? Math.floor(date.getTime() / 1000) : '';
        };

        startPicker.addEventListener('change', function () {
            syncUnix(startPicker, startUnix);
            if (endPicker.value && new Date(endPicker.value) < new Date(startPicker.value)) {
                endPicker.value = startPicker.value;
                syncUnix(endPicker, endUnix);
            }
        });

        endPicker.addEventListener('change', function () {
            syncUnix(endPicker, endUnix);
        });

        syncUnix(startPicker, startUnix);
        syncUnix(endPicker, endUnix);
    </script>
}