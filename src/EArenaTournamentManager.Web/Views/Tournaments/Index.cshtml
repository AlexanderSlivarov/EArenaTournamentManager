@model List<EArenaTournamentManager.Web.Models.Tournaments.TournamentResponse>
@{
    ViewData["Title"] = "Tournaments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Tournaments</h2>
    @if (ViewBag.IsLoggedIn == true)
    {
        <a asp-action="Create" class="btn btn-primary">Create Tournament</a>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">No tournaments found.</p>
}
else
{
    <div class="row">
        @foreach (var tournament in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@tournament.Name</h5>
                        <p class="card-text">
                            <span class="badge bg-@(tournament.Status == "Open" ? "success" : tournament.Status == "Closed" ? "secondary" : "danger")">
                                @tournament.Status
                            </span>
                        </p>
                        @if (!string.IsNullOrEmpty(tournament.Region))
                        {
                            <p class="card-text"><small class="text-muted">Region: @tournament.Region</small></p>
                        }
                        @if (!string.IsNullOrEmpty(tournament.Format))
                        {
                            <p class="card-text"><small class="text-muted">Format: @tournament.Format</small></p>
                        }
                        <p class="card-text">
                            <small class="text-muted">
                                Date: @(DateTimeOffset.FromUnixTimeSeconds(tournament.DateTime).ToString("dd MMM yyyy"))
                            </small>
                        </p>
                        <p class="card-text"><small class="text-muted">Created: @((tournament.CreatedOn > 0) ? DateTimeOffset.FromUnixTimeSeconds(tournament.CreatedOn).ToLocalTime().ToString("dd MMM yyyy") : string.Empty)</small></p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@tournament.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        @if (ViewBag.IsLoggedIn == true)
                        {
                            <a asp-action="Edit" asp-route-id="@tournament.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@tournament.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this tournament?')">
                                    Delete
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}