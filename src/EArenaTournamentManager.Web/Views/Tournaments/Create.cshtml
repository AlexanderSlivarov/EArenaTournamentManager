@model EArenaTournamentManager.Web.Models.Tournaments.TournamentRequest
@{
    ViewData["Title"] = "Create Tournament";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">Create Tournament</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="GameId" class="form-label"></label>
                    <input asp-for="GameId" type="number" class="form-control" />
                    <span asp-validation-for="GameId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="OrganizationId" class="form-label"></label>
                    <input asp-for="OrganizationId" type="number" class="form-control" />
                    <span asp-validation-for="OrganizationId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Format" class="form-label"></label>
                    <input asp-for="Format" class="form-control" placeholder="e.g. Single Elimination" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Region" class="form-label"></label>
                    <input asp-for="Region" class="form-control" placeholder="e.g. EU West" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Map" class="form-label"></label>
                <input asp-for="Map" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DateTime" class="form-label">Date & Time</label>
                    <input type="datetime-local" class="form-control" id="datetimePicker" />
                    <input asp-for="DateTime" type="hidden" id="dateTimeUnix" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="Closed">Closed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Prizes" class="form-label"></label>
                <input asp-for="Prizes" class="form-control" placeholder="e.g. 1st: $500" />
            </div>

            <div class="mb-3">
                <label asp-for="Rules" class="form-label"></label>
                <textarea asp-for="Rules" class="form-control" rows="4"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.getElementById('datetimePicker').addEventListener('change', function () {
            const date = new Date(this.value);
            document.getElementById('dateTimeUnix').value = Math.floor(date.getTime() / 1000);
        });
    </script>
}