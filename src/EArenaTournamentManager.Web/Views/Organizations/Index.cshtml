@model List<EArenaTournamentManager.Web.Models.Organizations.OrganizationResponse>
@{
    ViewData["Title"] = "Organizations";
}
@{
    var nameFilter = ViewBag.NameFilter as string ?? string.Empty;
    var typeFilter = ViewBag.TypeFilter as string ?? string.Empty;
    var currentPage = ViewBag.CurrentPage is int pageNumber ? pageNumber : 1;
    var pageSize = ViewBag.PageSize is int size ? size : 10;
    var pager = ViewBag.Pager as EArenaTournamentManager.Web.Models.Shared.PagerResponse;
    var totalCount = pager?.Count ?? Model.Count;
    var totalPages = pageSize > 0 ? (int)Math.Ceiling(totalCount / (double)pageSize) : 1;
    if (totalPages < 1)
    {
        totalPages = 1;
    }
    var pageSizes = new[] { 5, 10, 25, 50 };
}
<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Name</label>
            <input type="text" name="name" value="@nameFilter" class="form-control" placeholder="Search organizations" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Type</label>
            <select name="type" class="form-select">
                @if (string.IsNullOrWhiteSpace(typeFilter))
                {
                    <option value="" selected>All types</option>
                }
                else
                {
                    <option value="">All types</option>
                }

                @if (string.Equals(typeFilter, "Personal", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Personal" selected>Personal</option>
                }
                else
                {
                    <option value="Personal">Personal</option>
                }

                @if (string.Equals(typeFilter, "Business", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Business" selected>Business</option>
                }
                else
                {
                    <option value="Business">Business</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Organizations</h2>
    @if (ViewBag.IsLoggedIn == true)
    {
        <a asp-action="Create" class="btn btn-primary">Create Organization</a>
    }
</div>
@if (!Model.Any())
{
    <p class="text-muted">No organizations found.</p>
}
else
{
    <div class="row">
        @foreach (var org in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(org.HeaderImageUrl))
                    {
                        <img src="@org.HeaderImageUrl" class="card-img-top"
                             style="height:120px;object-fit:cover;" alt="@org.Name header" />
                    }
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            @if (!string.IsNullOrEmpty(org.LogoImageUrl))
                            {
                                <img src="@org.LogoImageUrl" alt="@org.Name logo"
                                     style="width:40px;height:40px;object-fit:cover;border-radius:50%;" />
                            }
                            <h5 class="card-title mb-0">@org.Name</h5>
                        </div>
                        <span class="badge bg-secondary mb-2">@org.Type</span>
                        @if (!string.IsNullOrEmpty(org.Description))
                        {
                            <p class="card-text text-muted">@org.Description</p>
                        }
                        <p class="card-text">
                            @if (ViewBag.IsAdmin == true)
                            {
                                <small class="text-muted">
                                    Created: @((org.CreatedOn > 0) ? DateTimeOffset.FromUnixTimeSeconds(org.CreatedOn).ToLocalTime().ToString("dd MMM yyyy") : string.Empty)
                                </small>
                            }
                        </p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@org.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        @if (ViewBag.IsAdmin == true || org.CreatedBy == ViewBag.CurrentUserId)
                        {
                            <a asp-action="Edit" asp-route-id="@org.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@org.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this organization?')">
                                    Delete
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mt-4">
    <div class="text-muted">
        Page @currentPage / @totalPages
    </div>

    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
        <div class="d-flex align-items-center gap-2">
            <label for="organizationPageSize" class="text-muted mb-0">Page size</label>
            <form method="get" class="d-inline">
                <input type="hidden" name="name" value="@nameFilter" />
                <input type="hidden" name="type" value="@typeFilter" />
                <input type="hidden" name="page" value="1" />
                <select id="organizationPageSize" name="pageSize" class="form-select" onchange="this.form.submit()" style="width:auto;min-width:110px;">
                    @foreach (var sizeOption in pageSizes)
                    {
                        if (sizeOption == pageSize)
                        {
                            <option value="@sizeOption" selected>@sizeOption</option>
                        }
                        else
                        {
                            <option value="@sizeOption">@sizeOption</option>
                        }
                    }
                </select>
            </form>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : string.Empty)"
               asp-action="Index"
               asp-route-name="@nameFilter"
               asp-route-type="@typeFilter"
               asp-route-page="@(currentPage - 1)"
               asp-route-pageSize="@pageSize">Prev</a>

            <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : string.Empty)"
               asp-action="Index"
               asp-route-name="@nameFilter"
               asp-route-type="@typeFilter"
               asp-route-page="@(currentPage + 1)"
               asp-route-pageSize="@pageSize">Next</a>
        </div>
    </div>
</div>