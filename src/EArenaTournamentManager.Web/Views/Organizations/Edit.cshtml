@model EArenaTournamentManager.Web.Models.Organizations.OrganizationRequest
@{
    ViewData["Title"] = "Edit Organization";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Edit Organization</h2>
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select">
                    <option value="Personal">Personal</option>
                    <option value="Business">Business</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Logo</label>
                <input type="hidden" asp-for="LogoImageUrl" id="logoImageUrl" />
                <div>
                    <img id="logoPreview"
                         src="@(string.IsNullOrEmpty(Model.LogoImageUrl) ? string.Empty : Model.LogoImageUrl)"
                         alt="Logo preview"
                         class="@(string.IsNullOrEmpty(Model.LogoImageUrl) ? "d-none " : string.Empty)img-thumbnail mb-2"
                         style="max-width:160px;max-height:160px;object-fit:cover;border-radius:12px;cursor:pointer;" />
                </div>
                <input type="file" class="d-none" id="logoFile" accept="image/*" />
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        onclick="document.getElementById('logoFile').click()">
                    Choose Logo
                </button>
            </div>
            <div class="mb-3">
                <label class="form-label">Header Image</label>
                <input type="hidden" asp-for="HeaderImageUrl" id="headerImageUrl" />
                <div>
                    <img id="headerPreview"
                         src="@(string.IsNullOrEmpty(Model.HeaderImageUrl) ? string.Empty : Model.HeaderImageUrl)"
                         alt="Header preview"
                         class="@(string.IsNullOrEmpty(Model.HeaderImageUrl) ? "d-none " : string.Empty)img-thumbnail mb-2"
                         style="max-width:320px;max-height:120px;object-fit:cover;cursor:pointer;" />
                </div>
                <input type="file" class="d-none" id="headerFile" accept="image/*" />
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        onclick="document.getElementById('headerFile').click()">
                    Choose Header
                </button>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function bindImagePicker(fileInputId, hiddenInputId, previewId, maxWidth, maxHeight, quality) {
            const fileInput = document.getElementById(fileInputId);
            const hiddenInput = document.getElementById(hiddenInputId);
            const preview = document.getElementById(previewId);

            hiddenInput.value = preview.getAttribute('src') || '';
            preview.addEventListener('click', () => fileInput.click());

            fileInput.addEventListener('change', function () {
                const file = this.files && this.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = new Image();
                    img.onload = function () {
                        const canvas = document.createElement('canvas');

                        let width = img.width;
                        let height = img.height;

                        if (width > maxWidth) {
                            height = Math.round(height * maxWidth / width);
                            width = maxWidth;
                        }
                        if (height > maxHeight) {
                            width = Math.round(width * maxHeight / height);
                            height = maxHeight;
                        }

                        canvas.width = width;
                        canvas.height = height;
                        canvas.getContext('2d').drawImage(img, 0, 0, width, height);

                        const compressed = canvas.toDataURL('image/jpeg', quality);
                        hiddenInput.value = compressed;
                        preview.src = compressed;
                        preview.classList.remove('d-none');
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        bindImagePicker('logoFile', 'logoImageUrl', 'logoPreview', 400, 400, 0.8);
        bindImagePicker('headerFile', 'headerImageUrl', 'headerPreview', 1200, 400, 0.75);
    </script>
}