@model EArenaTournamentManager.Web.Models.Organizations.OrganizationResponse
@{
    ViewData["Title"] = Model.Name;
    var staff = ViewBag.Staff as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var staffPager = ViewBag.StaffPager as EArenaTournamentManager.Web.Models.Shared.PagerResponse;
    var currentPage = ViewBag.StaffCurrentPage is int pageNumber ? pageNumber : 1;
    var pageSize = ViewBag.StaffPageSize is int size ? size : 10;
    var totalCount = staffPager?.Count ?? staff.Count();
    var totalPages = pageSize > 0 ? (int)Math.Ceiling(totalCount / (double)pageSize) : 1;
    if (totalPages < 1)
    {
        totalPages = 1;
    }
    var pageSizes = new[] { 5, 10, 25, 50 };
    var invitableUsers = ViewBag.InvitableUsers as IEnumerable<EArenaTournamentManager.Web.Models.Users.UserResponse> ?? Enumerable.Empty<EArenaTournamentManager.Web.Models.Users.UserResponse>();
    var upcomingTournaments = ViewBag.UpcomingTournaments as IEnumerable<EArenaTournamentManager.Web.Models.Tournaments.TournamentResponse> ?? Enumerable.Empty<EArenaTournamentManager.Web.Models.Tournaments.TournamentResponse>();
    var pastTournaments = ViewBag.PastTournaments as IEnumerable<EArenaTournamentManager.Web.Models.Tournaments.TournamentResponse> ?? Enumerable.Empty<EArenaTournamentManager.Web.Models.Tournaments.TournamentResponse>();
    bool isOwner = ViewBag.IsOwner == true;
    bool canManage = isOwner || ViewBag.IsAdmin == true;
    var staffRoles = new[] { "Admin", "Moderator", "BracketManager" };
}

@if (!string.IsNullOrEmpty(Model.HeaderImageUrl))
{
    <img src="@Model.HeaderImageUrl" alt="@Model.Name header"
         class="w-100 mb-4" style="height:200px;object-fit:cover;border-radius:8px;" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        @if (!string.IsNullOrEmpty(Model.LogoImageUrl))
        {
            <img src="@Model.LogoImageUrl" alt="@Model.Name"
                 style="width:64px;height:64px;object-fit:cover;border-radius:50%;" />
        }
        <div>
            <h2 class="mb-0">@Model.Name</h2>
            <span class="badge bg-secondary">@Model.Type</span>
            @if (isOwner)
            {
                <span class="badge bg-warning text-dark ms-1">Your Organization</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (canManage)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-danger"
                        onclick="return confirm('Delete this organization?')">
                    Delete
                </button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-primary">Back to list</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Organization Info</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">Owner</dt>
            <dd class="col-sm-9">
                @ViewBag.OwnerUsername
                @if (isOwner)
                {
                    <span class="badge bg-warning text-dark ms-1">You</span>
                }
            </dd>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <dt class="col-sm-3">About</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            }
        </dl>
    </div>
</div>

@if (ViewBag.IsAdmin == true)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Metadata</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9">@Model.CreatedBy</dd>
                <dt class="col-sm-3">Created On</dt>
                <dd class="col-sm-9">@((Model.CreatedOn > 0) ? DateTimeOffset.FromUnixTimeSeconds(Model.CreatedOn).ToLocalTime().ToString("dd MMM yyyy HH:mm") : string.Empty)</dd>
                <dt class="col-sm-3">Updated By</dt>
                <dd class="col-sm-9">@(Model.UpdatedBy.HasValue? Model.UpdatedBy.Value.ToString() : "-")</dd>
                <dt class="col-sm-3">Updated On</dt>
                <dd class="col-sm-9">@(Model.UpdatedOn.HasValue? DateTimeOffset.FromUnixTimeSeconds(Model.UpdatedOn.Value).ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-")</dd>
                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
            </dl>
        </div>
    </div>
}

@* Staff — owner and admin only *@
@if (canManage)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Staff</h5>
            <span class="badge bg-primary">@totalCount</span>
        </div>
        <div class="card-body p-0">
            <div class="px-3 pt-3 pb-0">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label for="organizationStaffUsernameFilter" class="form-label small text-muted mb-1">Username</label>
                        <input id="organizationStaffUsernameFilter" type="search" class="form-control form-control-sm" placeholder="Search username" />
                    </div>
                    <div class="col-md-5">
                        <label for="organizationStaffRoleFilter" class="form-label small text-muted mb-1">Role</label>
                        <select id="organizationStaffRoleFilter" class="form-select form-select-sm">
                            <option value="">All roles</option>
                            @foreach (var role in staffRoles)
                            {
                                <option value="@role">@(role == "BracketManager" ? "Bracket Manager" : role)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button id="organizationStaffApplyFilter" type="button" class="btn btn-sm btn-primary w-100">Filter</button>
                        <button id="organizationStaffClearFilter" type="button" class="btn btn-sm btn-outline-secondary w-100">Clear</button>
                    </div>
                </div>
            </div>
            @if (!staff.Any())
            {
                <p class="text-muted p-3 mb-0">No staff members yet.</p>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Since</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="organizationStaffTableBody">
                        @foreach (var entry in staff)
                        {
                            <tr data-username="@entry.Username" data-role="@entry.Staff.Role">
                                <td>@entry.Username</td>
                                <td>
                                    <form asp-controller="OrganizationStaff" asp-action="UpdateRole" method="post"
                                          class="d-flex gap-2 align-items-center">
                                        <input type="hidden" name="id" value="@entry.Staff.Id" />
                                        <input type="hidden" name="organizationId" value="@Model.Id" />
                                        <select name="role" class="form-select form-select-sm" style="min-width:130px;">
                                            @foreach (var r in staffRoles)
                                            {
                                                <option value="@r" selected="@(entry.Staff.Role == r ? "selected" : null)">@(r == "BracketManager" ? "Bracket Manager" : r)</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                    </form>
                                </td>
                                <td>@(entry.Staff.JoinedOn > 0 ? DateTimeOffset.FromUnixTimeSeconds((long)entry.Staff.JoinedOn).ToLocalTime().ToString("dd MMM yyyy") : "-")</td>
                                <td>
                                    <form asp-controller="OrganizationStaff" asp-action="Delete" method="post">
                                        <input type="hidden" name="id" value="@entry.Staff.Id" />
                                        <input type="hidden" name="organizationId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Remove @entry.Username from staff?')">
                                            Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p id="organizationStaffFilterEmpty" class="text-muted px-3 pb-3 mb-0 d-none">No staff members match your search.</p>
            }
        </div>
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 px-3 pb-3 pt-3">
            <div class="text-muted">Page @currentPage / @totalPages</div>
            <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <label for="staffPageSize" class="text-muted mb-0">Page size</label>
                    <form method="get" asp-action="Details" asp-route-id="@Model.Id" class="d-inline">
                        <input type="hidden" name="page" value="1" />
                        <select id="staffPageSize" name="pageSize" class="form-select" onchange="this.form.submit()" style="width:auto;min-width:110px;">
                            @foreach (var sizeOption in pageSizes)
                            {
                                if (sizeOption == pageSize)
                                {
                                    <option value="@sizeOption" selected>@sizeOption</option>
                                }
                                else
                                {
                                    <option value="@sizeOption">@sizeOption</option>
                                }
                            }
                        </select>
                    </form>
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : string.Empty)"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-pageSize="@pageSize">Prev</a>
                    <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : string.Empty)"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-pageSize="@pageSize">Next</a>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <h6 class="mb-2">Add Staff Member</h6>
            @if (!invitableUsers.Any())
            {
                <p class="text-muted mb-0 small">All users are already staff.</p>
            }
            else
            {
                <form asp-controller="OrganizationStaff" asp-action="Create" method="post"
                      class="d-flex gap-2 align-items-end flex-wrap">
                    <input type="hidden" name="OrganizationId" value="@Model.Id" />
                    <div>
                        <label class="form-label mb-1 small">User</label>
                        <select name="UserId" class="form-select form-select-sm" style="min-width:180px;">
                            @foreach (var user in invitableUsers)
                            {
                                <option value="@user.Id">@user.Username</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-1 small">Role</label>
                        <select name="Role" class="form-select form-select-sm" style="min-width:140px;">
                            @foreach (var r in staffRoles)
                            {
                                <option value="@r">@(r == "BracketManager" ? "Bracket Manager" : r)</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Add</button>
                </form>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const usernameInput = document.getElementById('organizationStaffUsernameFilter');
            const roleInput = document.getElementById('organizationStaffRoleFilter');
            const applyButton = document.getElementById('organizationStaffApplyFilter');
            const clearButton = document.getElementById('organizationStaffClearFilter');
            const rows = Array.from(document.querySelectorAll('#organizationStaffTableBody tr'));
            const emptyState = document.getElementById('organizationStaffFilterEmpty');

            if (!usernameInput || !roleInput || !applyButton || !clearButton) {
                return;
            }

            const applyFilter = () => {
                const usernameTerm = usernameInput.value.trim().toLowerCase();
                const roleTerm = roleInput.value.trim().toLowerCase();
                let visibleCount = 0;

                rows.forEach((row) => {
                    const rowUsername = (row.dataset.username || '').toLowerCase();
                    const rowRole = (row.dataset.role || '').toLowerCase();
                    const matchesUsername = !usernameTerm || rowUsername.includes(usernameTerm);
                    const matchesRole = !roleTerm || rowRole.includes(roleTerm);
                    const matches = matchesUsername && matchesRole;
                    row.classList.toggle('d-none', !matches);
                    if (matches) {
                        visibleCount += 1;
                    }
                });

                if (emptyState) {
                    emptyState.classList.toggle('d-none', visibleCount > 0);
                }
            };

            applyButton.addEventListener('click', applyFilter);
            clearButton.addEventListener('click', () => {
                usernameInput.value = '';
                roleInput.value = '';
                applyFilter();
            });
        })();
    </script>
}

@* Upcoming tournaments *@
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Upcoming &amp; Active Tournaments</h5>
        <span class="badge bg-primary">@upcomingTournaments.Count()</span>
    </div>
    <div class="card-body p-0">
        @if (!upcomingTournaments.Any())
        {
            <p class="text-muted p-3 mb-0">No upcoming tournaments.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in upcomingTournaments)
                    {
                        <tr>
                            <td><a asp-controller="Tournaments" asp-action="Details" asp-route-id="@t.Id">@t.Name</a></td>
                            <td><span class="badge bg-success">@t.Status</span></td>
                            <td>@(t.StartDate > 0 ? DateTimeOffset.FromUnixTimeSeconds(t.StartDate).ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-")</td>
                            <td>@(t.EndDate > 0 ? DateTimeOffset.FromUnixTimeSeconds(t.EndDate).ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Past Tournaments</h5>
        <span class="badge bg-secondary">@pastTournaments.Count()</span>
    </div>
    <div class="card-body p-0">
        @if (!pastTournaments.Any())
        {
            <p class="text-muted p-3 mb-0">No past tournaments.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in pastTournaments)
                    {
                        <tr>
                            <td><a asp-controller="Tournaments" asp-action="Details" asp-route-id="@t.Id">@t.Name</a></td>
                            <td><span class="badge bg-secondary">@t.Status</span></td>
                            <td>@(t.StartDate > 0 ? DateTimeOffset.FromUnixTimeSeconds(t.StartDate).ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-")</td>
                            <td>@(t.EndDate > 0 ? DateTimeOffset.FromUnixTimeSeconds(t.EndDate).ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>