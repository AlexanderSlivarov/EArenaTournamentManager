<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EArenaTournamentManager.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EArenaTournamentManager.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentRole = Context.Session.GetString("Role") ?? string.Empty;
        var isLoggedIn = Context.Session.GetString("Username") != null;
        var isAdmin = string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase);
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EArenaTournamentManager.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="manageDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    Manage
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="manageDropdown">
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Users</a></li>
                                    <li><a class="dropdown-item" asp-controller="Games" asp-action="Index">Games</a></li>
                                    <li><a class="dropdown-item" asp-controller="Organizations" asp-action="Index">Organizations</a></li>
                                    <li><a class="dropdown-item" asp-controller="Teams" asp-action="Index">Teams</a></li>
                                    <li><a class="dropdown-item" asp-controller="Tournaments" asp-action="Index">Tournaments</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="browseDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    Browse
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="browseDropdown">
                                    <li><a class="dropdown-item" asp-controller="Games" asp-action="Index">Games</a></li>
                                    <li><a class="dropdown-item" asp-controller="Tournaments" asp-action="Index">Tournaments</a></li>
                                    <li><a class="dropdown-item" asp-controller="Organizations" asp-action="Index">Organizations</a></li>
                                    @if (isLoggedIn)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Teams" asp-action="Index">Teams</a></li>                                        
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                                   id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(Context.Session.GetString("Avatar")))
                                    {
                                        <img src="@Context.Session.GetString("Avatar")"
                                             alt="avatar"
                                             style="width:32px;height:32px;border-radius:50%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="width:32px;height:32px;border-radius:50%;background:#6c757d;display:inline-flex;align-items:center;justify-content:center;color:white;font-size:14px;">
                                            @Context.Session.GetString("Username")?[0].ToString().ToUpper()
                                        </span>
                                    }
                                    <span class="px-0">@Context.Session.GetString("Username")</span>
                                    @if (!string.IsNullOrWhiteSpace(currentRole))
                                    {
                                        <span class="badge rounded-pill role-badge">@currentRole</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark" aria-labelledby="profileDropdown">
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="Profile">Profile</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Auth" asp-action="Logout">Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EArenaTournamentManager.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>